<Window x:Class="GoidaLauncher.TokenLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход по токену лицензии"
        Height="430" Width="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="🔑" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Вход по токену лицензии" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Вставьте Access Token (Bearer) учётной записи Minecraft / Mojang. Лаунчер проверит его и привяжет лицензионный профиль."
                   Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Поле ввода токена -->
        <TextBlock Grid.Row="2" Text="Access Token:" Foreground="{StaticResource TextSecondary}"
                   FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="TokenBox" Grid.Row="3" Height="90" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="4"
                   Text="Принимается как чистый токен, так и строка 'Bearer ...' или JSON."
                   Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,12"/>

        <CheckBox x:Name="DownloadSkinCheck" Grid.Row="4" Margin="0,20,0,12" IsChecked="True"
                  Content="Скачать скин из профиля Mojang и применить в лаунчере"/>

        <!-- Статус / Ошибка -->
        <Border x:Name="StatusBorder" Grid.Row="5" Visibility="Collapsed" Background="#1E2029"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Кнопки -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" Content="Отмена" Height="36"
                    Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
            <Button x:Name="LoginButton" Grid.Column="2" Content="Войти" Height="36"
                    Style="{StaticResource LaunchButton}" FontSize="14" Click="LoginButton_Click"/>
        </Grid>
    </Grid>
</Window>
