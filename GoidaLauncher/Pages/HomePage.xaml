<UserControl x:Class="GoidaLauncher.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoidaLauncher.Pages"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ЦЕНТРАЛЬНАЯ СЦЕНА -->
        <Grid Grid.Row="0">
            <!-- 3D персонаж игрока (смещён левее) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="95,0,0,0"
                    Width="360" Height="430" Background="Transparent" Cursor="Hand"
                    ToolTip="Потяните мышью для вращения 3D-модели">
                <local:SkinViewer3D x:Name="PlayerModel3D"/>
            </Border>


            <!-- ПРАВАЯ ВСПЛЫВАЮЩАЯ ПАНЕЛЬ: Консоль игры -->
            <Border Width="310" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,24,0" Style="{StaticResource GoidaCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок консоли с кнопкой сворачивания -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="📋 Консоль игры" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Button x:Name="ToggleConsoleButton" Content="Свернуть" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource AccentGreen}" Cursor="Hand"
                                FontSize="11" Click="ToggleConsoleButton_Click"/>
                    </Grid>

                    <Border Grid.Row="1" x:Name="ConsolePanel" Height="300" Margin="0,10,0,0"
                            Background="#090C16" CornerRadius="8" BorderThickness="1"
                            BorderBrush="#1D253B" Padding="8">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextSecondary}" FontFamily="Consolas"
                                     FontSize="11" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- НИЖНЯЯ ПЛАВАЮЩАЯ ПАНЕЛЬ ЗАПУСКА -->
        <Border Grid.Row="1" Margin="24,0,24,18" Padding="16,12"
                Style="{StaticResource GoidaCard}" Background="{DynamicResource BgPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Выбор сборки и загрузчика -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#1B243B"
                            BorderThickness="1" BorderBrush="#2D3B5C" Margin="0,0,12,0">
                        <TextBlock x:Name="LoaderIconText" Text="⚡" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Версия игры" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <Button Grid.Column="1" x:Name="GoInstallButton" Content="+ Установить"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource AccentGreen}" Cursor="Hand"
                                    Padding="0" FontSize="11" Margin="8,0,0,0"
                                    Click="GoInstallButton_Click"/>
                        </Grid>
                        <ComboBox x:Name="BuildCombo" Width="200" DisplayMemberPath="Display"/>
                        <TextBlock x:Name="NoBuildsHint" Visibility="Collapsed"
                                   Text="Нет установленных версий" Foreground="#EF4444"
                                   FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Центр: Статус и прогресс-бар -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,28,0">
                    <TextBlock x:Name="StatusText" Text="Готов к запуску"
                               Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,6" TextAlignment="Center"/>
                    <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100"
                                 Background="#1B2338" Foreground="{DynamicResource AccentGreen}"
                                 BorderThickness="0"/>
                </StackPanel>

                <!-- Правая часть: Кнопка "▶ ИГРАТЬ" -->
                <Button Grid.Column="2" x:Name="LaunchButton" Content="ИГРАТЬ" Height="52" Width="190"
                        Style="{StaticResource PrimaryPlayButton}" Click="LaunchButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
