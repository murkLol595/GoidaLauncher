<UserControl x:Class="GoidaLauncher.Pages.ModrinthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + Контекст версии -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Каталог дополнений Modrinth" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Быстрый поиск и установка модов, шейдеров и текстурпаков в один клик"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#161E30" CornerRadius="8"
                    BorderThickness="1" BorderBrush="#253555" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🟢 " FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="ContextText" Text="Загрузка профиля..."
                               Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Меню выбора категорий (Скриншот 3) -->
        <Border Grid.Row="1" Background="#121622" BorderBrush="#232C42" BorderThickness="1"
                CornerRadius="19" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,12">
            <StackPanel x:Name="CategoryPillsPanel" Orientation="Horizontal"/>
        </Border>

        <!-- Строка поиска и фильтров -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поле поиска -->
            <Border Grid.Column="0" Background="#151A29" CornerRadius="8"
                    BorderThickness="1" BorderBrush="#253555" Padding="10,0" Height="38">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍 " FontSize="13" VerticalAlignment="Center" Foreground="#7E8B9F" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent"
                             BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                             FontSize="13" VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"/>
                </Grid>
            </Border>

            <!-- Чекбокс фильтра по текущей версии -->
            <CheckBox x:Name="FilterVersionCheck" Grid.Column="2" Content="Только для моей версии"
                      IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                      FontSize="12" Checked="FilterVersionCheck_Changed" Unchecked="FilterVersionCheck_Changed"/>

            <!-- Кнопка поиска -->
            <Button x:Name="SearchButton" Grid.Column="4" Content="Искать" Width="100" Height="38"
                    Style="{StaticResource LaunchButton}" FontSize="13" Click="SearchButton_Click"/>
        </Grid>

        <!-- Список результатов (Карточки с иконками) -->
        <Border Grid.Row="3" Background="{DynamicResource BgPanel}"
                CornerRadius="{DynamicResource PanelCornerRadius}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                Padding="8" Effect="{StaticResource CardShadow}">
            <ScrollViewer x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Нижняя панель: статус и пагинация страниц -->
        <Border Grid.Row="4" Background="#131826" CornerRadius="10"
                BorderThickness="1" BorderBrush="#212C42" Padding="14,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevPageButton" Content="◀  Назад" Width="85" Height="30"
                            Style="{StaticResource GoidaPillButton}" FontSize="12" Margin="0,0,8,0"
                            Click="PrevPageButton_Click"/>
                    <TextBlock x:Name="PageIndicatorText" Text="Страница 1 / 1" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"
                               Margin="6,0,14,0"/>
                    <Button x:Name="NextPageButton" Content="Вперёд  ▶" Width="85" Height="30"
                            Style="{StaticResource GoidaPillButton}" FontSize="12"
                            Click="NextPageButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
