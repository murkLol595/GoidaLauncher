<UserControl x:Class="GoidaLauncher.Pages.ModrinthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Моды и текстурпаки (Modrinth)" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
        <TextBlock x:Name="ContextText" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" MaxWidth="320"/>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ProjectTypeCombo" Grid.Column="0" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="Моды" Tag="mod"/>
                <ComboBoxItem Content="Текстурпаки" Tag="resourcepack"/>
                <ComboBoxItem Content="Шейдеры" Tag="shader"/>
            </ComboBox>

            <TextBox x:Name="SearchBox" Grid.Column="2" VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown"/>

            <Button x:Name="SearchButton" Grid.Column="4" Content="Искать" Width="90" Height="30"
                    Style="{StaticResource LaunchButton}" FontSize="13" Click="SearchButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource BgPanel}"
                CornerRadius="{DynamicResource PanelCornerRadius}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                Padding="8" Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsList"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0"
                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
