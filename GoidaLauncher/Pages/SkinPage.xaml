<UserControl x:Class="GoidaLauncher.Pages.SkinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoidaLauncher.Pages"
             FontFamily="Segoe UI">

    <Grid Margin="28,16,28,20">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: ТЕКУЩИЙ СКИН -->
            <ColumnDefinition Width="340"/>
            <!-- Разделитель -->
            <ColumnDefinition Width="32"/>
            <!-- Правая колонка: БИБЛИОТЕКА -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: ТЕКУЩИЙ СКИН -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок Текущий -->
            <TextBlock Grid.Row="0" Text="Текущий" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>

            <!-- 3D вьюпорт персонажа -->
            <Border Grid.Row="1" CornerRadius="14" Style="{StaticResource GoidaCard}" Padding="12"
                    ClipToBounds="True">
                <local:SkinViewer3D x:Name="Viewer3D"/>
            </Border>

            <!-- Кнопки под 3D-моделью -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Button x:Name="UploadSkinButton" Content="+ Добавить в библиотеку" Height="38"
                        Style="{StaticResource LaunchButton}" FontSize="13" FontWeight="Bold"
                        Click="UploadSkinButton_Click" Margin="0,0,0,8"/>
                <Button x:Name="OpenSkinsFolderButton" Content="📁  Папка скинов" Height="32"
                        Style="{StaticResource SecondaryButton}" FontSize="12"
                        Click="OpenSkinsFolderButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ВЕРТИКАЛЬНЫЙ РАЗДЕЛИТЕЛЬ -->
        <Rectangle Grid.Column="1" Width="1" Fill="#222B3F" HorizontalAlignment="Center"
                   Margin="0,10,0,10"/>

        <!-- ПРАВАЯ КОЛОНКА: БИБЛИОТЕКА СКИНОВ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок Библиотека -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Библиотека" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Сетка библиотеки со скроллом -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="SkinsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
