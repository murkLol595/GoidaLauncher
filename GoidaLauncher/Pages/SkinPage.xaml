<UserControl x:Class="GoidaLauncher.Pages.SkinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoidaLauncher.Pages"
             FontFamily="Segoe UI">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 3D-превью текущего активного скина -->
        <Border Grid.Column="0" CornerRadius="10" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <local:SkinViewer3D x:Name="Viewer3D"/>
        </Border>

        <!-- Библиотека скинов -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="Скины" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <Button x:Name="UploadSkinButton" Content="+ Загрузить скин" Width="160" Height="34"
                        HorizontalAlignment="Right" Style="{StaticResource LaunchButton}" FontSize="13"
                        Click="UploadSkinButton_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       FontSize="12" Margin="0,0,0,16" HorizontalAlignment="Left">
                Скины хранятся тут в общей библиотеке и одинаково доступны во всех установленных
                сборках. Применяет их мод <Run FontStyle="Italic">CustomSkinLoader</Run> — поставьте его
                в загрузчик (Fabric/Forge/Quilt), лаунчер сам положит выбранный скин туда, где мод его ищет.
            </TextBlock>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="SkinsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
