<UserControl x:Class="GoidaLauncher.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Настройки" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <Button x:Name="SaveButton" Content="Сохранить" Width="120" Height="34"
                            HorizontalAlignment="Right" Style="{StaticResource LaunchButton}"
                            FontSize="13" Click="SaveButton_Click"/>
                </Grid>

                <TextBlock x:Name="SavedHintText" Text="" FontSize="12"
                           Foreground="{DynamicResource AccentGreen}" Margin="0,0,0,12"/>

                <TextBlock Text="ПАМЯТЬ" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Мин. (МБ)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBox x:Name="MinRamBox" Text="1024"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Макс. (МБ)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBox x:Name="MaxRamBox" Text="2048"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="JAVA И ПАПКА ИГРЫ" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <TextBlock Text="Путь к Java (необязательно)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="JavaPathBox" Margin="0,0,0,12"
                         ToolTip="Оставьте пустым, чтобы лаунчер сам нашёл javaw.exe"/>

                <TextBlock Text="Папка игры" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GameDirBox" Grid.Column="0" IsReadOnly="True"/>
                    <Button x:Name="OpenGameDirButton" Grid.Column="2" Content="Открыть" Width="80"
                            Style="{StaticResource SecondaryButton}" Click="OpenGameDirButton_Click"/>
                </Grid>

                <TextBlock Text="Доп. параметры запуска (JVM)" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="CustomJvmArgsBox" Margin="0,0,0,20"
                         ToolTip="Например: -XX:+UseZGC. Добавляются в конец списка при каждом запуске."/>

                <TextBlock Text="DISCORD" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <CheckBox x:Name="DiscordRpcCheck" Content="Показывать статус в Discord (Rich Presence)"
                          Margin="0,0,0,8"/>
                <TextBlock Text="Discord Application ID (см. README)" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="DiscordAppIdBox" Margin="0,0,0,20"/>

                <TextBlock Text="ДИЗАЙН И СТИЛЬ ЛАУНЧЕРА" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>

                <!-- Пресеты тем -->
                <TextBlock Text="Стиль оформления" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
                <WrapPanel x:Name="ThemesPanel" Margin="0,0,0,16"/>

                <!-- Акцентный цвет -->
                <TextBlock Text="Акцентный цвет" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
                <WrapPanel x:Name="ColorSwatchPanel" Margin="0,0,0,16"/>

                <!-- Стиль логотипа -->
                <TextBlock Text="Стиль логотипа в шапке" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="LogoGoidaRadio" Content="GOIDA LAUNCHER" IsChecked="True"
                                 Margin="0,0,20,0" Checked="LogoRadio_Checked"/>
                    <RadioButton x:Name="LogoMillidaRadio" Content="MILLIDA LAUNCHER"
                                 Checked="LogoRadio_Checked"/>
                </StackPanel>

                <!-- Эффекты -->
                <TextBlock Text="ЭФФЕКТЫ И ОФОРМЛЕНИЕ" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <CheckBox x:Name="AnimatedBgCheck" Content="Анимированный живой фон (плавающие сферы)"
                          Margin="0,0,0,8" Click="DesignOption_Changed"/>
                <CheckBox x:Name="GlassmorphismCheck" Content="Эффект матового стекла (Glassmorphism)"
                          Margin="0,0,0,8" Click="DesignOption_Changed"/>
                <CheckBox x:Name="GlowEffectCheck" Content="Неоновое свечение кнопки «Играть» (Glow Effect)"
                          Margin="0,0,0,16" Click="DesignOption_Changed"/>

                <!-- Скругление углов -->
                <TextBlock Text="Скругление углов" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton x:Name="RadiusModernRadio" Content="Современное (14px)" Margin="0,0,16,0"
                                 Checked="RadiusRadio_Checked"/>
                    <RadioButton x:Name="RadiusClassicRadio" Content="Классика (8px)" Margin="0,0,16,0"
                                 Checked="RadiusRadio_Checked"/>
                    <RadioButton x:Name="RadiusSharpRadio" Content="Прямое (4px)"
                                 Checked="RadiusRadio_Checked"/>
                </StackPanel>

                <Button x:Name="ResetThemeButton" Content="Сбросить стиль по умолчанию (Millida)"
                        Height="32" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Padding="14,4" Margin="0,0,0,30" Click="ResetThemeButton_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
