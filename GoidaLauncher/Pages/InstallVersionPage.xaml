<UserControl x:Class="GoidaLauncher.Pages.InstallVersionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Margin="28,16,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Установка версии" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Выберите загрузчик и желаемую версию Minecraft для быстрой установки"
                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- БЛОК 1: Загрузчик (карточки) -->
        <Border Grid.Row="1" Style="{StaticResource GoidaCard}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ЗАГРУЗЧИК (MOD LOADER)" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>

                <UniformGrid x:Name="LoaderGrid" Columns="5">
                    <!-- Заполняется в коде: Fabric, Quilt, Forge, NeoForge, Vanilla -->
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- БЛОК 2: Версия Minecraft (поиск + сетка версий) -->
        <Border Grid.Row="2" Style="{StaticResource GoidaCard}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Фильтры поиска версий -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#161E30" CornerRadius="8"
                            BorderThickness="1" BorderBrush="#253555" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent"
                                     BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                     FontSize="12" TextChanged="SearchBox_TextChanged"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <CheckBox x:Name="ShowSnapshotsCheck" Grid.Column="2" Content="Отображать бета, снапшоты"
                              VerticalAlignment="Center" Checked="ShowSnapshotsCheck_Changed"
                              Unchecked="ShowSnapshotsCheck_Changed"/>
                </Grid>

                <!-- Сетка версий (WrapPanel с прокруткой) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="VersionWrapPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- БЛОК 3: Нижняя панель действий -->
        <Border Grid.Row="3" Background="{DynamicResource BgPanel}" CornerRadius="12"
                BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedSummaryText" Text="Выбрано: 1.21.11 (Fabric)"
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="StatusText" Text="Готов к установке"
                               FontSize="11" Foreground="{DynamicResource AccentGreen}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="ConfirmInstallButton" Content="📥  Выбрать и применить"
                        Style="{StaticResource PrimaryPlayButton}" Height="44" Padding="20,0"
                        Click="ConfirmInstallButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
